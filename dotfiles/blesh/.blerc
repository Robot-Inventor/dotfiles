bleopt highlight_syntax=
bleopt highlight_filename=
bleopt highlight_variable=

ble-face auto_complete='fg=244'

# Shift+Enter (Zed sends LF/C-j): insert a newline
ble-bind -m emacs -f 'C-j' newline

# Ctrl+Enter: execute the entire command buffer
ble-bind -m emacs -f 'C-RET' accept-line

function ble/widget/select-all {
  ble/widget/@nomarked beginning-of-text
  ble/widget/@marked end-of-text
}

ble-bind -m emacs -f 'C-a' select-all
