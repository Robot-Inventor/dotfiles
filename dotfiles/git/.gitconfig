[core]
	editor = {{ "vi" if os() == "linux" else "zed --wait" }}
	quotepath = false
	autocrlf = false
[user]
	email = 50550561+Robot-Inventor@users.noreply.github.com
	name = Robot-Inventor
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPM8KEzhw9sfCgLfxyO7KlMDxOAxJGZkQ24eHn8h3Edf
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[gpg]
	format = ssh
[commit]
	gpgsign = true
# {% if os() == "windows" %}
[gpg "ssh"]
program = op-ssh-sign.exe
# {% elif env.WSL_DISTRO_NAME is defined %}
[gpg "ssh"]
program = op-ssh-sign-wsl.exe
# {% endif %}
[alias]
	default = !git switch \"$(git symbolic-ref --short refs/remotes/origin/HEAD | sed \"s|^origin/||\")\"
	sweep = "!f() { default=$(git symbolic-ref --short refs/remotes/origin/HEAD) || return; default=${default#origin/}; git switch \"$default\" || return; git for-each-ref --format='%(refname:lstrip=2)' refs/heads | while IFS= read -r branch; do case \"$branch\" in \"$default\"|develop|gh-pages) ;; *) git branch -D -- \"$branch\" ;; esac; done; }; f"
