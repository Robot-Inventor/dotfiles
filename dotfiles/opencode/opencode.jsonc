{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "plugins": ["@robot-inventor/agent-skills@1.6.0"],
    "mcp": {
        "servers": {
            "browse": {
                "type": "local",
                "command": ["browse.exe", "mcp"],
                "environment": {
                    "OPENCODE_BROWSER_RUNTIME": "auto-update"
                }
            }
        }
    }
}
