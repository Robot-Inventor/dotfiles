{
    "$schema": "https://opencode.ai/config.json",
    "lsp": true,
    "plugins": ["@robot-inventor/agent-skills@1.7.0"],
    "mcp": {
        "servers": {
            "browse": {
                "type": "local",
                "command": ["browse.exe", "mcp"],
                "environment": {
                    "OPENCODE_BROWSER_RUNTIME": "auto-update"
                }
            }
        }
    },
    "policies": [
        {
            "action": "mcp.use",
            "resource": "opencode_console",
            "effect": "deny"
        },
        {
            "action": "provider.use",
            "resource": "opencode",
            "effect": "deny"
        }
    ]
}
